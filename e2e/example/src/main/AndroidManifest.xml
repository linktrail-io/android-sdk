<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Backup disabled on purpose: Auto Backup restores SharedPreferences on Play reinstalls,
         resurrecting the SDK's install-tracked/consent state and breaking fresh-install
         (deferred deep link) testing. Attribution SDK hosts should exclude SDK prefs from backup. -->
    <application
        android:name=".KickFlipApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KickFlip">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KickFlip">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified App Links: https://<link host>/<slug> opens the app when installed. The host is
                 linktrail.linkHost (default kick.linktrail.io); it needs a Digital Asset Links file at
                 https://<link host>/.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${linktrailLinkHost}" />
                <!-- linktrail.customLinkHost (default: the link host again): the custom domain. -->
                <data android:scheme="https" android:host="${linktrailCustomLinkHost}" />
            </intent-filter>

            <!-- Custom scheme for testing / non-verified re-engagement deep links, e.g.
                 adb shell am start -a android.intent.action.VIEW \
                   -d "kickflip://products/aj1?voucher=SUMMER25&discountPercent=25" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kickflip" />
            </intent-filter>
        </activity>
    </application>
</manifest>
