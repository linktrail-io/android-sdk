<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only backend override, read by the SDK in debuggable apps.
             Set it with the Gradle property linktrail.base or the LINKTRAIL_BASE env var; empty means
             production. Release builds never carry it, and the SDK ignores it there anyway. -->
        <meta-data
            android:name="LINKTRAIL_BASE"
            android:value="${linktrailBase}" />
    </application>
</manifest>
